{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "自媒搭子",
  "mainBinaryName": "zimeidazi",
  "version": "../package.json",
  "identifier": "com.zimeidazi.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "自媒搭子",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "面向小白的自媒体创作工作台",
    "copyright": "基于开源项目 Easel（Apache-2.0）",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../../build/easel/": "easel/",
      "../../bootstrap/": "bootstrap/"
    }
  }
}
